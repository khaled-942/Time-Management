rules_version = '2';

// Assumes every user profile is stored at users/{uid} (as RegisterComponent does).
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && me().get('isAdmin', false) == true;
    }

    // One role per person: 'pm', 'leader' or 'member' (missing means member)
    function myRole() {
      return me().get('role', 'member');
    }

    function isPM() {
      return signedIn() && myRole() == 'pm';
    }

    function myTeam() {
      return me().get('teamId', '');
    }

    // Admins and project managers see and manage every team task
    function managesAll() {
      return isAdmin() || isPM();
    }

    // Deactivated people (active == false) can still read, but not write
    function isActive() {
      return signedIn() && me().get('active', true) != false;
    }

    // Payroll period key ("YYYY-MM", named after the month of the 10th) for a "YYYY-MM-DD" day id
    function periodKeyOf(dayId) {
      let y = int(dayId[0:4]);
      let m = int(dayId[5:7]);
      let next = int(dayId[8:10]) > 10 ? m + 1 : m;
      let endYear = next > 12 ? y + 1 : y;
      let endMonth = next > 12 ? 1 : next;
      return string(endYear) + '-' + (endMonth < 10 ? '0' : '') + string(endMonth);
    }

    function validTimeEntry(e) {
      return e.title is string && e.title.size() > 0 && e.title.size() <= 200
        && e.projectId is string
        && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && e.start is string && e.start.matches('^[0-9]{2}:[0-9]{2}$')
        && e.end is string && (e.end == '' || (e.end.matches('^[0-9]{2}:[0-9]{2}$') && e.end > e.start))
        && e.note is string && e.note.size() <= 1000;
    }

    function validTask(t) {
      return t.title is string && t.title.size() > 0 && t.title.size() <= 200
        && t.description is string && t.description.size() <= 5000
        && t.type in ['feature', 'bug', 'review_fixes', 'chore']
        && t.priority in ['low', 'medium', 'high', 'urgent']
        && t.status in ['backlog', 'todo', 'in_progress', 'review', 'changes', 'done']
        && t.order is number
        && t.projectId is string
        && t.assigneeIds is list && t.assigneeIds.size() <= 20
        && t.teamIds is list && t.teamIds.size() <= 10
        && t.parentId is string
        && t.createdBy is string
        && t.dueDate is string
        && (t.estimateHours == null || t.estimateHours is number)
        && t.links is list && t.links.size() <= 10
        && t.checklist is list && t.checklist.size() <= 50
        && t.reviewNote is string && t.reviewNote.size() <= 1000;
    }

    function periodLocked(dayId) {
      return exists(/databases/$(database)/documents/lockedPeriods/$(periodKeyOf(dayId)));
    }

    match /users/{userId} {
      // Owners are matched on the userId field so the app's `where('userId', '==', uid)` queries are allowed
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['isAdmin', 'salary', 'active', 'role', 'teamId']);

      // Users may edit their own profile, but never their admin flag, active flag, role, team or id.
      // The salary lives in private/salary; the profile may only drop its old copy.
      allow update: if isAdmin() || (isActive()
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'active', 'userId', 'role', 'teamId'])
        && !('salary' in request.resource.data && request.resource.data.diff(resource.data).affectedKeys().hasAny(['salary'])));

      allow delete: if isAdmin();

      // Private to the owner — admins can't read or change it
      match /private/{docId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow write: if isActive() && userId == request.auth.uid
          && docId == 'salary'
          && request.resource.data.salary is number
          && request.resource.data.salary >= 0;
      }

      // Private task log: only the owner, never admins, PMs or leaders
      match /timeEntries/{entryId} {
        allow read, delete: if signedIn() && userId == request.auth.uid;
        allow create, update: if isActive() && userId == request.auth.uid && validTimeEntry(request.resource.data);
      }

      match /days/{dayId} {
        allow read: if isAdmin() || (signedIn() && userId == request.auth.uid);
        // Employees can't change days in a closed payroll period; admins can
        allow write: if isAdmin() || (isActive() && userId == request.auth.uid && !periodLocked(dayId));
      }
    }

    // Public part of each profile (name, avatar, role, team). Anyone signed in can read it;
    // people write their own entry, but role/team/active must match their real profile.
    match /directory/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'name', 'avatar', 'role', 'teamId', 'active'])
        && request.resource.data.userId == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 2000
        && request.resource.data.role == myRole()
        && request.resource.data.teamId == myTeam()
        && request.resource.data.active == me().get('active', true));
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Shared project list: admins and project managers maintain it, everyone picks from it
    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if (isAdmin() || (isActive() && isPM()))
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (isActive() && isPM());
      allow delete: if isAdmin();
    }

    // Team tasks. The creator is the reviewer. Each read branch matches one TaskService.watch query.
    match /tasks/{taskId} {
      allow read: if managesAll() || (signedIn() && (
        (myTeam() != '' && myTeam() in resource.data.teamIds)
        || request.auth.uid in resource.data.assigneeIds
        || resource.data.createdBy == request.auth.uid));

      // PMs/admins create for anyone; team leaders only for their own team; members can't create
      allow create: if isActive() && validTask(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (managesAll() || (myRole() == 'leader' && myTeam() != '' && request.resource.data.teamIds == [myTeam()]));

      allow update: if isActive() && validTask(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && (managesAll()
          // The creator (a leader) edits freely but keeps the task in their team
          || (resource.data.createdBy == request.auth.uid && request.resource.data.teamIds == [myTeam()])
          // Assignees only move unfinished tasks up to Need review and tick the checklist
          || (request.auth.uid in resource.data.assigneeIds
            && resource.data.status != 'done'
            && request.resource.data.status in ['backlog', 'todo', 'in_progress', 'review']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'order', 'checklist', 'updatedAt'])));

      allow delete: if managesAll() || resource.data.createdBy == request.auth.uid;
    }

    match /holidays/{holidayId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /leaveRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Owners may only cancel their own pending request; admins decide
      allow update: if isAdmin() || (signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      allow delete: if false;
    }

    // Every notification has both fields: userId (personal) or audience == 'admins' (shared), the other empty
    match /notifications/{notificationId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
          || (resource.data.audience == 'admins' && isAdmin()));

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.readBy == [];

      // Readers may only add themselves to readBy
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid
          || (resource.data.audience == 'admins' && isAdmin()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);

      allow delete: if false;
    }

    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.changedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /lockedPeriods/{periodKey} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
