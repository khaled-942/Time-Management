rules_version = '2';

// Assumes every user profile is stored at users/{uid} (as RegisterComponent does).
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    match /users/{userId} {
      // Owners are matched on the userId field so the app's `where('userId', '==', uid)` queries are allowed
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['isAdmin', 'salary']);

      // Users may edit their own profile, but never their admin flag, salary or id
      allow update: if isAdmin() || (signedIn()
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'salary', 'userId']));

      allow delete: if isAdmin();

      match /days/{dayId} {
        allow read, write: if isAdmin() || (signedIn() && userId == request.auth.uid);
      }
    }

    match /holidays/{holidayId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
